<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHRM Regression Suite" verbose="1">
    <listeners>
        <listener class-name="com.mahmoud.automation.listeners.TestListener"/>
    </listeners>

    <test name="Smoke Tests">
        <classes>
            <class name="com.mahmoud.automation.tests.SmokeTest"/>
        </classes>
    </test>

    <test name="Login Tests">
        <classes>
            <class name="com.mahmoud.automation.tests.LoginTest"/>
        </classes>
    </test>

    <test name="PIM Module Tests">
        <classes>
            <class name="com.mahmoud.automation.tests.PimTest"/>
        </classes>
    </test>

</suite>